---
import type { Guide } from '../data/guides';

const { guide } = Astro.props as { guide: Guide };
---

<a class="guide-card" href={`/guides/${guide.slug}/`}>
  <div><span>{guide.category}</span><span>{guide.readTime}</span></div>
  <h3>{guide.title}</h3>
  <p>{guide.description}</p>
  <strong>Read the guide →</strong>
</a>
