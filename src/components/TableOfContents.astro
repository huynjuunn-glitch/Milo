---
interface Heading { depth: number; slug: string; text: string }
const { headings, moduleTitles = [] } = Astro.props as { headings: Heading[]; moduleTitles?: string[] };
const articleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const items = [
  { href: '#at-a-glance', text: 'At a glance', depth: 2 },
  ...moduleTitles.map((text, index) => ({ href: `#field-module-${index + 1}`, text, depth: 2 })),
  ...articleHeadings.map((heading) => ({ href: `#${heading.slug}`, text: heading.text, depth: heading.depth })),
  { href: '#sources', text: 'Sources and verification', depth: 2 },
  { href: '#change-log', text: 'Change log', depth: 2 },
];
---

<nav class="article-toc article-toc--desktop" aria-label="On this page">
  <strong>On this page</strong>
  <ol>
    {items.map((item) => <li class:list={{ nested: item.depth === 3 }}><a href={item.href}>{item.text}</a></li>)}
  </ol>
</nav>

<details class="article-toc-mobile">
  <summary>On this page</summary>
  <nav aria-label="On this page, mobile navigation">
    <ol>
      {items.map((item) => <li class:list={{ nested: item.depth === 3 }}><a href={item.href}>{item.text}</a></li>)}
    </ol>
  </nav>
</details>
