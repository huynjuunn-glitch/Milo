---
import type { Tool } from '../data/tools';

const { tool } = Astro.props as { tool: Tool };
---

<section class="calculator" data-calculator={tool.slug} aria-labelledby="calculator-title">
  <div class="calculator__header">
    <div>
      <p class="eyebrow">Interactive calculator</p>
      <h2 id="calculator-title">Enter your measurements</h2>
    </div>
    <span class="local-note"><span aria-hidden="true">●</span> Runs in your browser</span>
  </div>

  <form class="calculator__form" novalidate>
    <div class="input-grid">
      {tool.inputs.map((input) => (
        <label class:list={['field', { 'field--wide': input.wide }] }>
          <span>{input.label}</span>
          <div class="field__control">
            {input.type === 'select' ? (
              <select name={input.id} data-input={input.id}>
                {input.options?.map((option) => <option value={option.value} selected={option.value === input.value}>{option.label}</option>)}
              </select>
            ) : input.type === 'textarea' ? (
              <textarea name={input.id} data-input={input.id} rows="6" placeholder={input.placeholder}>{input.value}</textarea>
            ) : (
              <input
                name={input.id}
                data-input={input.id}
                type={input.type ?? 'text'}
                value={input.value}
                placeholder={input.placeholder}
                min={input.min}
                max={input.max}
                step={input.step}
                inputmode={input.type === 'number' ? 'decimal' : 'text'}
              />
            )}
            {input.unit && <b>{input.unit}</b>}
          </div>
          {input.help && <small>{input.help}</small>}
        </label>
      ))}
    </div>
    <div class="calculator__actions">
      <button class="button" type="submit">Calculate</button>
      <button class="button button--ghost" type="reset">Reset</button>
    </div>
  </form>

  <div class="calculator__output" aria-live="polite" aria-atomic="true">
    <div class="result-empty">
      <span aria-hidden="true">⌁</span>
      <p>Your result will appear here.</p>
    </div>
  </div>
  <div class="result-toolbar" hidden>
    <button type="button" data-copy-result>Copy result</button>
    <button type="button" onclick="window.print()">Print</button>
  </div>
  <p class="calculator__hint">{tool.resultHint}</p>
</section>

<script src="../scripts/calculators.ts"></script>
