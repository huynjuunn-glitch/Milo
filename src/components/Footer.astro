---
import { NAVIGATION } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <a class="brand brand-light" href="/" aria-label="Dama Korea home">
        <span class="brand-mark" aria-hidden="true">담</span>
        <span class="brand-type"><strong>Dama</strong><small>KOREA FIELD GUIDES</small></span>
      </a>
      <p>Independent English-language field guides for seeing Korean heritage with context, practical preparation and respect.</p>
    </div>
    <div>
      <strong>Explore</strong>
      {NAVIGATION.slice(0, 5).map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/culture/">All heritage guides</a>
    </div>
    <div>
      <strong>Editorial</strong>
      <a href="/about/">About & methodology</a>
      <a href="/contact/">Corrections & suggestions</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Dama Korea</span>
    <span>Research before recommendation. Context before checklist.</span>
  </div>
</footer>
