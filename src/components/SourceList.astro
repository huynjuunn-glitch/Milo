---
import type { Source } from "../data/content";
const { sources } = Astro.props as { sources: Source[] };
---

<section class="source-list" aria-labelledby="source-heading">
  <h2 id="source-heading">Sources checked</h2>
  <ul>
    {sources.map((source) => (
      <li>
        <a href={source.url} target="_blank" rel="noopener noreferrer">
          {source.title}
        </a>
        {source.publisher && <span> · {source.publisher}</span>}
      </li>
    ))}
  </ul>
</section>
