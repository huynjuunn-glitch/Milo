---
const { links } = Astro.props as {
  links: Array<{ label: string; href: string }>;
};
---

<section class="related-links" aria-labelledby="related-heading">
  <h2 id="related-heading">Continue with a related check</h2>
  <ul>
    {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
</section>
