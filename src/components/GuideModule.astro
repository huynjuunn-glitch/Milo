---
import type { GuideData } from '../lib/guides';

type Module = GuideData['modules'][number];
const { module, index } = Astro.props as { module: Module; index: number };
const labels: Record<Module['type'], string> = {
  decision: 'Decision guide',
  route: 'Field route',
  timeline: 'Sequence',
  'look-for': 'What to notice',
  etiquette: 'Respect on site',
  notice: 'Before you rely on this',
};
const sectionId = `field-module-${index + 1}`;
---

<section class:list={['field-module', `field-module--${module.type}`]} id={sectionId}>
  <div class="field-module__head">
    <span>{labels[module.type]}</span>
    <h2>{module.title}</h2>
    {module.intro && <p>{module.intro}</p>}
  </div>
  <ol class="field-module__items">
    {module.items.map((item, itemIndex) => (
      <li>
        <span aria-hidden="true">{String(itemIndex + 1).padStart(2, '0')}</span>
        <div><h3>{item.heading}</h3><p>{item.text}</p></div>
      </li>
    ))}
  </ol>
</section>
