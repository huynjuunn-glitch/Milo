---
import type { Tool } from '../data/tools';
import { CATEGORIES } from '../data/site';

const { tool, compact = false } = Astro.props as { tool: Tool; compact?: boolean };
---

<a class:list={['tool-card', { 'tool-card--compact': compact }]} href={`/tools/${tool.slug}/`} data-tool-card={tool.slug}>
  <div class="tool-card__top">
    <span class="tool-card__icon" aria-hidden="true">
      {tool.category === 'layout' ? '↗' : tool.category === 'materials' ? '▤' : '▦'}
    </span>
    {tool.badge && <span class="badge">{tool.badge}</span>}
  </div>
  <p>{CATEGORIES[tool.category].label}</p>
  <h3>{tool.shortTitle}</h3>
  <span>{tool.description}</span>
  <strong>Open calculator <span aria-hidden="true">→</span></strong>
</a>
