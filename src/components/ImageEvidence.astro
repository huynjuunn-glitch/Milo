---
import data from "../../public/evidence/manifest.json";
const { kind = "formats", full = false } = Astro.props as {
  kind?: string;
  full?: boolean;
};
const bytes = (n: number) => `${n.toLocaleString("en-US")} B`;
const specimens = full
  ? data.cases
  : data.cases.filter((c) => ["cup", "texture", "noise"].includes(c.id));
---

<section class="file-evidence" aria-label="Downloadable worked example">
  {
    kind === "formats" && (
      <>
        <h2>Same pixels, different files</h2>
        <p>
          Actual reference-encoder exports, measured {data.measuredOn}. Every
          input is 1200 × 900 pixels, flattened onto white. JPG and WebP use
          quality 85; PNG uses lossless encoding. Equal quality numbers do not
          mean equal visual quality across formats.
        </p>
        <div class="table-wrap">
          <table>
            <>
              <caption>
                Download an input or an output to inspect it at 100%.
              </caption>
              <thead>
                <tr>
                  <>
                    <th scope="col">Test image</th>
                    <th scope="col">JPG</th>
                    <th scope="col">PNG</th>
                    <th scope="col">WebP</th>
                  </>
                </tr>
              </thead>
              <tbody>
                {specimens.map((item) => (
                  <tr>
                    <th scope="row">
                      <a href={item.input.url} download>
                        {item.label}
                      </a>
                      <small>{item.kind}</small>
                    </th>
                    {(["jpeg", "png", "webp"] as const).map((format) => (
                      <td>
                        <a href={item.outputs[format].url} download>
                          {bytes(item.outputs[format].bytes)}
                        </a>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </>
          </table>
        </div>
        <div class="proof-images">
          {specimens.slice(0, full ? 6 : 2).map((item) => (
            <figure>
              <img
                src={item.outputs.jpeg.url}
                width="1200"
                height="900"
                alt={item.label}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {item.label}. Preview is the JPG; compare the downloadable
                outputs.
              </figcaption>
            </figure>
          ))}
        </div>
        <p>
          The woven pattern favors PNG; the seeded noise favors JPG over WebP.
          These fixtures demonstrate dependence on image content, not a
          universal format ranking. Your browser and marketplace can encode
          differently.
        </p>
      </>
    )
  }
  {
    kind === "framing" && (
      <>
        <>
          <h2>One photo, two square exports</h2>
          <p>
            The downloadable source is {data.framing.source.width} ×{" "}
            {data.framing.source.height}. Both outputs are 800 × 800, centered,
            at zero margin. These files use the site's framing calculations and
            a reference encoder.
          </p>
        </>
        <div class="proof-images">
          {data.framing.outputs.map((item) => (
            <figure>
              <a href={item.file.url} download>
                <img
                  src={item.file.url}
                  width="800"
                  height="800"
                  alt={
                    item.mode === "contain"
                      ? "Whole portrait photograph fitted on a white square"
                      : "Portrait photograph enlarged to fill a square, cropping its top and bottom"
                  }
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                {item.mode === "contain"
                  ? "Fit: whole source, white side margins."
                  : "Fill: square covered, source edges removed."}
              </figcaption>
            </figure>
          ))}
        </div>
        <p>
          Fit scales the source to about 607 × 800. Fill scales it to about 800
          × 1054 before removing about 127 output pixels from each vertical
          edge. Pixel rounding and interpolation can differ in a browser.{" "}
          <a href={data.framing.source.url} download>
            Download the portrait source
          </a>
          .
        </p>
      </>
    )
  }
  {
    kind === "crops" && (
      <>
        <>
          <h2>What a center crop removes</h2>
          <p>
            These are actual cropped files from the same 800 × 800 reference
            export. They illustrate geometry and do not reproduce Etsy's
            interface.
          </p>
          <div class="proof-images three-up">
            {data.crops.map((item) => (
              <figure>
                <a href={item.file.url} download>
                  <img
                    src={item.file.url}
                    width={item.file.width}
                    height={item.file.height}
                    alt={`${item.label} ${item.ratio} crop of the cup sample`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption>
                  {item.ratio}: {item.removed}.
                </figcaption>
              </figure>
            ))}
          </div>
        </>
        <p>
          The square already has side padding. A portrait crop can remove
          padding while a landscape crop removes source content vertically. This
          is why you must inspect the subject instead of treating every removed
          pixel as damage.
        </p>
      </>
    )
  }
  {
    kind === "scale" && (
      <>
        <>
          <h2>Same canvas, smaller subject</h2>
          <p>
            Both files are 800 × 800. The second puts a 400-pixel-high source
            into the same square. A source with extra space can therefore make a
            collection look uneven even when every uploaded file has identical
            dimensions.
          </p>
          <div class="proof-images">
            <>
              <figure>
                <>
                  <img
                    src={data.framing.outputs[0].file.url}
                    width="800"
                    height="800"
                    alt="Cup source fitted to an 800 pixel square"
                    loading="lazy"
                  />
                  <figcaption>
                    Source frame fills the square's height.
                  </figcaption>
                </>
              </figure>
              <figure>
                <>
                  <img
                    src={data.scale.url}
                    width="800"
                    height="800"
                    alt="The same photograph occupies half the height in an identical square"
                    loading="lazy"
                  />
                  <figcaption>
                    Source frame occupies half the height.{" "}
                    <a href={data.scale.url} download>
                      Download
                    </a>
                    .
                  </figcaption>
                </>
              </figure>
            </>
          </div>
        </>
      </>
    )
  }
  {
    kind === "batch" && (
      <>
        <>
          <h2>Inspect a finished ZIP</h2>
          <p>
            This reference archive contains three real JPG exports named using
            the site's filename function. It demonstrates names and archive
            contents; it is not a captured marketplace upload.
          </p>
          <div class="table-wrap">
            <table>
              <>
                <thead>
                  <tr>
                    <>
                      <th>Input</th>
                      <th>Export</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {data.batch.entries.map((entry, index) => (
                    <tr>
                      <td>
                        <a href={entry.source} download>
                          Test input {index + 1}
                        </a>
                      </td>
                      <td>
                        <a href={entry.output} download>
                          {entry.name}
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
          <p>
            <a href={data.batch.url} download>
              Download the verified three-file ZIP ({bytes(data.batch.bytes)})
            </a>
            . Extract it and confirm the names, dimensions and file types before
            using the workflow on your own images.
          </p>
        </>
      </>
    )
  }
  {
    kind === "memory" && (
      <>
        <>
          <h2>Disk size and decoded pixels</h2>
          <p>
            These downloadable JPGs have the same dimensions but different
            encoded sizes. Each needs 4,320,000 bytes for one hypothetical 8-bit
            RGBA buffer: 1200 × 900 × 4. That is a calculation, not a
            measurement of total browser memory.
          </p>
          <div class="table-wrap">
            <table>
              <>
                <thead>
                  <tr>
                    <>
                      <th>Sample</th>
                      <th>Actual file bytes</th>
                      <th>One RGBA buffer</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {data.cases
                    .filter((item) => ["cup", "noise"].includes(item.id))
                    .map((item) => (
                      <tr>
                        <th>
                          <a href={item.outputs.jpeg.url} download>
                            {item.label}
                          </a>
                        </th>
                        <td>{bytes(item.outputs.jpeg.bytes)}</td>
                        <td>4,320,000 B</td>
                      </tr>
                    ))}
                </tbody>
              </>
            </table>
          </div>
          <p>
            A small compressed file can still have many pixels. Decode copies,
            canvases and thumbnails add overhead. Use dimensions and smaller
            batches to diagnose a stalled tab; do not infer device limits from
            this table.
          </p>
        </>
      </>
    )
  }
  {
    kind === "transparency" && (
      <>
        <>
          <h2>Flattening chooses a background</h2>
          <p>
            The same transparent source is composited onto two backgrounds.
            These JPG outputs cannot retain transparency. Select the background
            before exporting instead of expecting a file extension to choose it
            for you.
          </p>
          <div class="proof-images">
            <>
              <figure>
                <>
                  <img
                    src={data.transparency.white.url}
                    width="1200"
                    height="900"
                    alt="Transparent test graphic flattened onto white"
                    loading="lazy"
                  />
                  <figcaption>
                    White composite.{" "}
                    <a href={data.transparency.white.url} download>
                      Download JPG
                    </a>
                    .
                  </figcaption>
                </>
              </figure>
              <figure>
                <>
                  <img
                    src={data.transparency.black.url}
                    width="1200"
                    height="900"
                    alt="The same test graphic flattened onto black"
                    loading="lazy"
                  />
                  <figcaption>
                    Black composite.{" "}
                    <a href={data.transparency.black.url} download>
                      Download JPG
                    </a>
                    .
                  </figcaption>
                </>
              </figure>
            </>
          </div>
          <p>
            <a href={data.transparency.source.url} download>
              Download the PNG with its alpha channel
            </a>{" "}
            and open it over different backgrounds in an alpha-aware editor. The
            input is a generated test graphic.
          </p>
        </>
      </>
    )
  }
  <details class="evidence-credit">
    <summary>Image sources and reproduction</summary><p>
      Photographs: <a href={data.cases[0].credit!.source}
        >Coffee Cup, The Metropolitan Museum of Art</a
      >; <a href={data.cases[1].credit!.source}
        >Coffee cup and coffee bean, mcfoodie</a
      >. Both are <a href="https://creativecommons.org/publicdomain/zero/1.0/"
        >CC0</a
      >. They are third-party test material, not photographs taken by this
      project. Pattern, text, transparency and noise fixtures are generated
      tests.
    </p><p>
      Measured {data.measuredOn} with sharp {data.encoder.sharp}, libvips {
        data.encoder.vips
      }, Node {data.encoder.node}. <a href="/evidence/manifest.json" download
        >Download all dimensions, byte counts and SHA-256 hashes</a
      >. <a
        href="https://github.com/huynjuunn-glitch/Milo/blob/main/scripts/generate-evidence.mjs"
        >Reproduction script</a
      >.
    </p>
  </details>
</section>
<style>
  .file-evidence {
    margin-block: 40px;
    padding: 28px;
    background: #eaf0f7;
    min-width: 0;
  }
  .file-evidence h2 {
    font-size: 1.5rem;
  }
  .proof-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-block: 24px;
  }
  .proof-images.three-up {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .proof-images figure {
    margin: 0;
  }
  .proof-images img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
    background: white;
  }
  .proof-images figcaption,
  .evidence-credit {
    font-size: 14px;
    margin-top: 10px;
  }
  .file-evidence small {
    display: block;
    font-weight: 400;
  }
  .file-evidence td {
    font-variant-numeric: tabular-nums;
  }
  .evidence-credit summary {
    cursor: pointer;
    font-weight: 650;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .file-evidence a {
    overflow-wrap: anywhere;
  }
  @media (max-width: 600px) {
    .file-evidence {
      padding: 18px;
      margin-inline: -8px;
    }
    .proof-images,
    .proof-images.three-up {
      grid-template-columns: 1fr;
    }
    .proof-images img {
      max-height: 440px;
    }
    .file-evidence td,
    .file-evidence th {
      padding: 10px;
      font-size: 14px;
    }
  }
</style>
