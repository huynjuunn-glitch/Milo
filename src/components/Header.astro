---
import { NAVIGATION } from '../data/site';

const { activeNav } = Astro.props as { activeNav?: string };
const path = Astro.url.pathname;
const isCurrent = (href: string) => activeNav ? activeNav === href : path.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="담Dama Korea Field Guides, home">
      <span class="brand-mark" aria-hidden="true">담</span>
      <span class="brand-type"><strong>Dama</strong><small>KOREA FIELD GUIDES</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {NAVIGATION.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary><span>Menu</span><span aria-hidden="true">＋</span></summary>
      <nav aria-label="Mobile navigation">
        {NAVIGATION.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
