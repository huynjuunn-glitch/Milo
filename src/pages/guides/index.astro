---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { guides } from "../../data/guides";
const groups = [...new Set(guides.map((guide) => guide.category))];
---

<BaseLayout
  title="Product Photo Workflow Guides"
  description="Solve image framing, format, batch naming and export problems with complete guides and downloadable worked examples."
  activeNav="/guides/"
>
  <section class="legal-hero legal-shell">
    <h1>Product photo guides</h1><p>
      Choose the problem you need to solve. Each guide combines a practical
      procedure with downloadable files or a worked example you can inspect.
    </p>
  </section>
  <div class="legal-content legal-shell guide-directory">
    {
      groups.map((group) => (
        <section>
          <>
            <h2>{group}</h2>
            <ul>
              {guides
                .filter((guide) => guide.category === group)
                .map((guide) => (
                  <li>
                    <h3>
                      <a href={`/guides/${guide.slug}/`}>{guide.title}</a>
                    </h3>
                    <p>{guide.description}</p>
                  </li>
                ))}
            </ul>
          </>
        </section>
      ))
    }<section>
      <h2>Before publishing</h2><p>
        Check the <a href="/marketplace/">destination's current requirements</a> and
        inspect its saved preview. A local export can verify file properties but does
        not reproduce a storefront theme.
      </p><p>
        <a href="/experiments/">Inspect the examples and measurements</a> or <a
          href="/tools/">open the local browser tools</a
        >.
      </p>
    </section>
  </div>
</BaseLayout>
<style>
  .guide-directory > section {
    margin-bottom: 48px;
  }
  .guide-directory ul {
    list-style: none;
    padding: 0;
  }
  .guide-directory li + li {
    margin-top: 28px;
  }
  .guide-directory h3 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .guide-directory p {
    color: var(--ink);
  }
</style>
