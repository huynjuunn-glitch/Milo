---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { guides } from "../../data/guides";
---

<BaseLayout
  title="Etsy Seller Workflow Guides"
  description="Practical, evidence-led guides to product image framing, thumbnail crops, file quality, naming and browser batch troubleshooting."
  noindex
  activeNav="/guides/"
  ><section class="shell legal-hero">
    <p class="eyebrow">SELLER OPERATIONS LAB</p><h1>
      Etsy seller workflow guides
    </h1><p>
      Worked examples, source checks and limitations for a repeatable product-file workflow.
    </p>
  </section><section class="shell legal-content guide-grid">
    {
      guides.map((g) => (
        <a class="guide-card" href={`/guides/${g.slug}/`}>
          <>
            <span>{g.category.toUpperCase()}</span>
            <h2>{g.title}</h2>
            <p>{g.description}</p>
          </>
        </a>
      ))
    }
  </section></BaseLayout
>
