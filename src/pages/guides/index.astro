---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { guides } from "../../data/guides";
---

<BaseLayout
  title="Product Photo Preparation Guides"
  description="Practical guides to product image framing, thumbnail crops, file quality, naming and browser batch troubleshooting."
  activeNav="/guides/"
  ><section class="shell legal-hero">
    <p class="eyebrow">THE PREP DESK</p><h1>
      Better decisions before you export.
    </h1><p>
      Worked examples and checklists for a repeatable product-photo workflow.
    </p>
  </section><section class="shell legal-content guide-grid">
    {
      guides.map((g) => (
        <a class="guide-card" href={`/guides/${g.slug}/`}>
          <>
            <span>{g.category.toUpperCase()}</span>
            <h2>{g.title}</h2>
            <p>{g.description}</p>
          </>
        </a>
      ))
    }
  </section></BaseLayout
>
