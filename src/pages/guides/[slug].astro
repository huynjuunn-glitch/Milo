---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import GuideModule from '../../components/GuideModule.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { SITE } from '../../data/site';
import { formatEditorialDate, getPublicGuides, guideUrl, isoDate, sectionLabel, sectionUrl, type GuideEntry } from '../../lib/guides';

export async function getStaticPaths() {
  const guides = await getPublicGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: GuideEntry };
const { Content, headings } = await render(guide as CollectionEntry<'guides'>);
const allGuides = await getPublicGuides();
const relatedGuides = guide.data.related
  .map((slug) => allGuides.find((candidate) => candidate.id === slug))
  .filter((candidate): candidate is GuideEntry => Boolean(candidate));
const canonical = new URL(guideUrl(guide), SITE.url).toString();
const hero = guide.data.heroImage;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: isoDate(guide.data.publishedAt),
  dateModified: isoDate(guide.data.updatedAt),
  inLanguage: 'en',
  isAccessibleForFree: true,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: hero ? new URL(hero.src, SITE.url).toString() : undefined,
  author: { '@type': 'Organization', name: guide.data.author.name, url: new URL(guide.data.author.url, SITE.url).toString() },
  publisher: { '@id': `${SITE.url}/#organization` },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: sectionLabel(guide.data.section), item: new URL(sectionUrl(guide.data.section), SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: guide.data.title, item: canonical },
  ],
};
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  image={hero?.src}
  imageAlt={hero?.alt}
  type="article"
  adsEligible={guide.data.adStatus !== 'none'}
  activeNav={sectionUrl(guide.data.section)}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article>
    <header class="article-hero">
      <div class="shell visual-shell">
        <div class="article-hero__copy">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span>
            <a href={sectionUrl(guide.data.section)}>{sectionLabel(guide.data.section)}</a><span aria-hidden="true">/</span>
            <span aria-current="page">Field guide</span>
          </nav>
          <p class="eyebrow">{sectionLabel(guide.data.section)}</p>
          <h1>{guide.data.title}</h1>
          <p class="article-dek">{guide.data.summary}</p>
          <div class="article-meta">
            <span>By <a href={guide.data.author.url}>{guide.data.author.name}</a></span>
            <span>Published {formatEditorialDate(guide.data.publishedAt)}</span>
            <span>Checked {formatEditorialDate(guide.data.checkedAt)}</span>
          </div>
        </div>
        {hero && (
          <figure class="article-hero__figure">
            <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" />
            {(hero.caption || hero.credit) && <figcaption>{hero.caption} <span>Image: {hero.credit} · {hero.license}</span></figcaption>}
          </figure>
        )}
      </div>
    </header>

    <div class="shell article-layout">
      <aside class="article-sidebar"><TableOfContents headings={headings} moduleTitles={guide.data.modules.map((module) => module.title)} /></aside>
      <div class="article-column">
        <section class="at-a-glance" id="at-a-glance" aria-labelledby="at-a-glance-title">
          <p class="eyebrow">Field notes</p>
          <h2 id="at-a-glance-title">At a glance</h2>
          <dl>{guide.data.atAGlance.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
        </section>

        {guide.data.modules.map((module, index) => <GuideModule module={module} index={index} />)}

        <div class="article-body"><Content /></div>

        <section class="source-box" id="sources">
          <p class="eyebrow">Verification desk</p>
          <h2>Sources and what each one verifies</h2>
          <p>Sources are linked for a defined job. They do not imply that the organization endorses Dama Korea.</p>
          <ol>
            {guide.data.sources.map((source) => (
              <li>
                <h3><a href={source.url} rel="external">{source.label}</a></h3>
                <p>{source.role}</p>
                <small>Source checked {formatEditorialDate(source.checkedAt)}</small>
              </li>
            ))}
          </ol>
        </section>

        <section class="change-log" id="change-log">
          <p class="eyebrow">Editorial record</p>
          <h2>Change log</h2>
          <ol>{guide.data.changes.map((change) => <li><time datetime={isoDate(change.date)}>{formatEditorialDate(change.date)}</time><span>{change.summary}</span></li>)}</ol>
          <p>See something that changed? <a href="/contact/">Send a correction with the page URL and an official source.</a></p>
        </section>
      </div>
    </div>
  </article>

  {relatedGuides.length > 0 && (
    <section class="section section--paper">
      <div class="shell">
        <div class="section-head"><div><p class="eyebrow">Continue in context</p><h2>Related field guides</h2></div></div>
        <div class="guide-grid">{relatedGuides.map((item) => <GuideCard guide={item} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
