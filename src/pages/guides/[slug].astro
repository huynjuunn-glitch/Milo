---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { guides, type Guide } from '../../data/guides';
import { getTool } from '../../data/tools';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const relatedTools = guide.relatedTools.map(getTool).filter((tool) => Boolean(tool));
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    datePublished: guide.publishedAt,
    dateModified: guide.updatedAt,
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: new URL(`/guides/${guide.slug}/`, SITE.url).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', SITE.url).toString() },
      { '@type': 'ListItem', position: 3, name: guide.title, item: new URL(`/guides/${guide.slug}/`, SITE.url).toString() },
    ],
  },
];
---

<BaseLayout title={guide.title} description={guide.description} type="article" activeNav="/guides/" schema={schema}>
  <article class="guide-article">
    <header class="guide-hero">
      <div class="article-shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/guides/">Guides</a><span>/</span><span>{guide.category}</span></nav>
        <p class="eyebrow">{guide.category} · {guide.readTime}</p>
        <h1>{guide.title}</h1>
        <p class="guide-deck">{guide.intro}</p>
        <div class="article-meta"><span>Published {guide.publishedAt}</span><span>Updated {guide.updatedAt}</span><span>By Dama Workshop</span></div>
      </div>
    </header>

    <div class="article-shell article-body">
      <nav class="article-toc" aria-label="On this page"><strong>On this page</strong><ol>{guide.sections.map((section, index) => <li><a href={`#section-${index + 1}`}>{section.heading}</a></li>)}</ol></nav>
      {guide.sections.map((section, index) => (
        <section id={`section-${index + 1}`}>
          <span class="section-number">{String(index + 1).padStart(2, '0')}</span>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul class="check-list">{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        </section>
      ))}
      <aside class="takeaway"><span>Bottom line</span><p>{guide.takeaway}</p></aside>
      <div class="article-disclosure"><strong>How this guide was made</strong><p>Dama Workshop writes from standard workshop math and clearly stated construction assumptions. We do not claim hands-on testing that did not occur. Corrections are logged through the public contact channel.</p></div>
    </div>
  </article>
  <section class="section section--paper"><div class="shell"><div class="section-head"><div><p class="eyebrow">Use the numbers</p><h2>Related calculators</h2></div></div><div class="tool-grid">{relatedTools.map((tool) => tool && <ToolCard tool={tool} compact />)}</div></div></section>
</BaseLayout>
