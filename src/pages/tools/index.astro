---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { CATEGORIES } from '../../data/site';
---

<BaseLayout title="Woodworking Calculators" description="Browse free woodworking calculators for shop math, layout, cut lists, lumber, sheet goods, cabinet doors and drawers." activeNav="/tools/">
  <section class="page-hero page-hero--tools">
    <div class="shell page-hero__grid">
      <div><p class="eyebrow">Calculator library</p><h1>One clean answer.<br />Back to the bench.</h1></div>
      <p>{tools.length} focused tools for measurements that repeat: fractional inches, spacing, material yield, angles and cabinet sizing. Every calculator works without an account and keeps inputs in your browser.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell category-stack">
      {Object.entries(CATEGORIES).map(([key, category]) => {
        const categoryTools = tools.filter((tool) => tool.category === key);
        return (
          <section class="tool-category" id={key}>
            <div class="category-heading"><div><span>{String(categoryTools.length).padStart(2, '0')} tools</span><h2>{category.label}</h2></div><p>{category.description}</p></div>
            <div class="tool-grid">{categoryTools.map((tool) => <ToolCard tool={tool} />)}</div>
          </section>
        );
      })}
    </div>
  </section>

  <section class="section standards-callout">
    <div class="shell standards-grid">
      <div><p class="eyebrow">Before you cut</p><h2>A precise result is still an estimate of the physical work.</h2></div>
      <div><p>Actual stock, blade kerf, hardware specifications and machine setup control the finished result. Use these calculators to remove arithmetic—not test cuts and judgment.</p><a class="text-link" href="/about/">Read our calculation policy →</a></div>
    </div>
  </section>
</BaseLayout>
