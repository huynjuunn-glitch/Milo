---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Korea Heritage Visit Worksheet" description="A private, browser-based worksheet for checking official notices, Korean map data, route effort and respectful conduct before a heritage visit.">
  <section class="page-hero"><div class="shell visual-shell"><div><p class="eyebrow">Free planning tool</p><h1>Check the heritage day before leaving reliable Wi-Fi.</h1><p class="page-hero__lede">This worksheet stores selections only in this browser. It does not replace the official notice for a site or transport service.</p></div></div></section>
  <section class="section section--paper"><div class="shell tool-layout">
    <aside><p class="eyebrow">Use it in order</p><h2>Remove the failures that can erase the visit.</h2><p>Site context makes the day meaningful. These checks make sure the gate, route and conduct assumptions still hold when you arrive.</p><button class="button button--secondary" type="button" data-reset-checklists>Reset worksheet</button></aside>
    <div class="tool-stack">
      <section class="interactive-tool" data-checklist="authority"><span>01 · Authority</span><h2>Current site information</h2><div class="tool-checks">
        <label><input type="checkbox" /><span>I opened the responsible heritage authority’s current notice, not only a map listing.</span></label>
        <label><input type="checkbox" /><span>I checked closure days, last admission and any reservation or guided-access requirement.</span></label>
        <label><input type="checkbox" /><span>I saved the official page or a current screenshot for the visit date.</span></label>
      </div><div class="tool-progress" aria-hidden="true"><span></span></div><p class="tool-result" aria-live="polite">0 of 3 checks complete</p></section>
      <section class="interactive-tool" data-checklist="route"><span>02 · Route</span><h2>Place and transport data</h2><div class="tool-checks">
        <label><input type="checkbox" /><span>I saved the official Korean place name and the practical entrance, not only a general pin.</span></label>
        <label><input type="checkbox" /><span>I checked the final walk, slopes, stairs and the return journey.</span></label>
        <label><input type="checkbox" /><span>I have an offline address or route if mobile data fails.</span></label>
      </div><div class="tool-progress" aria-hidden="true"><span></span></div><p class="tool-result" aria-live="polite">0 of 3 checks complete</p></section>
      <section class="interactive-tool" data-checklist="respect"><span>03 · Respect</span><h2>Weather, access and conduct</h2><div class="tool-checks">
        <label><input type="checkbox" /><span>I checked weather and walking conditions for exposed stone, mountain paths or large grounds.</span></label>
        <label><input type="checkbox" /><span>I will follow posted photography, worship and restricted-access instructions on site.</span></label>
        <label><input type="checkbox" /><span>I chose one fallback if a building, trail, ceremony or transport link is unavailable.</span></label>
      </div><div class="tool-progress" aria-hidden="true"><span></span></div><p class="tool-result" aria-live="polite">0 of 3 checks complete</p></section>
      <div class="tool-summary"><strong data-total-result>0 of 9 visit checks complete</strong><p>Completion is not a safety guarantee. Recheck time-sensitive information with the responsible organization.</p><button class="button" type="button" onclick="window.print()">Print or save as PDF</button></div>
    </div>
  </div></section>
  <script is:inline>
    const tools = [...document.querySelectorAll('[data-checklist]')];
    const total = document.querySelector('[data-total-result]');
    const updateAll = () => {
      let complete = 0;
      let count = 0;
      tools.forEach((tool) => {
        const key = `dama-heritage-${tool.getAttribute('data-checklist')}`;
        const boxes = [...tool.querySelectorAll('input[type="checkbox"]')];
        const done = boxes.filter((box) => box.checked).length;
        complete += done;
        count += boxes.length;
        tool.querySelector('.tool-progress span').style.width = `${done / boxes.length * 100}%`;
        tool.querySelector('.tool-result').textContent = `${done} of ${boxes.length} checks complete`;
        localStorage.setItem(key, JSON.stringify(boxes.map((box) => box.checked)));
      });
      total.textContent = `${complete} of ${count} visit checks complete`;
    };
    tools.forEach((tool) => {
      const key = `dama-heritage-${tool.getAttribute('data-checklist')}`;
      const boxes = [...tool.querySelectorAll('input[type="checkbox"]')];
      try {
        const saved = JSON.parse(localStorage.getItem(key) || '[]');
        boxes.forEach((box, index) => { box.checked = Boolean(saved[index]); });
      } catch {}
      boxes.forEach((box) => box.addEventListener('change', updateAll));
    });
    document.querySelector('[data-reset-checklists]')?.addEventListener('click', () => {
      tools.forEach((tool) => tool.querySelectorAll('input[type="checkbox"]').forEach((box) => { box.checked = false; }));
      updateAll();
    });
    updateAll();
  </script>
</BaseLayout>
