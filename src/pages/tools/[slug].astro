---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/Calculator.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, getRelatedTools, SOURCE_LIBRARY, type Tool } from '../../data/tools';
import { CATEGORIES, SITE } from '../../data/site';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const related = getRelatedTools(tool);
const sources = tool.sourceKeys.map((key) => SOURCE_LIBRARY[key]);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.title,
    url: new URL(`/tools/${tool.slug}/`, SITE.url).toString(),
    description: tool.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    dateModified: '2026-09-04',
    isBasedOn: sources.map((source) => source.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Calculators', item: new URL('/tools/', SITE.url).toString() },
      { '@type': 'ListItem', position: 3, name: tool.shortTitle, item: new URL(`/tools/${tool.slug}/`, SITE.url).toString() },
    ],
  },
];
---

<BaseLayout title={tool.title} description={tool.description} activeNav="/tools/" schema={schema}>
  <section class="tool-hero">
    <div class="shell tool-hero__inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/">Calculators</a><span>/</span><span>{tool.shortTitle}</span></nav>
      <div class="tool-hero__grid">
        <div>
          <p class="eyebrow">{CATEGORIES[tool.category].label}</p>
          <h1>{tool.title}</h1>
          <p>{tool.intro}</p>
          <div class="verification-meta"><span>Version {tool.version}</span><span>Verified {tool.verifiedAt}</span><a href="/standards/">Testing standard</a></div>
        </div>
        <div class="tool-hero__note"><span aria-hidden="true">✓</span><div><strong>Free. Private. Immediate.</strong><p>No sign-up. No measurements uploaded. Copy or print the result when you are done.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section section--calculator">
    <div class="shell tool-layout">
      <Calculator tool={tool} />
      <aside class="tool-sidebar">
        <div class="sidebar-card"><span>Formula</span><strong>{tool.formula}</strong></div>
        <div class="sidebar-card"><span>Worked example</span><p>{tool.example.setup}</p><strong>{tool.example.result}</strong></div>
        <div class="sidebar-card sidebar-card--warning"><span>Shop rule</span><p>Verify the first finished part or test cut before producing a batch.</p></div>
      </aside>
    </div>
  </section>

  <article class="tool-article">
    <div class="article-shell">
      <section>
        <p class="eyebrow">Calculation method</p>
        <h2>How this calculator gets the answer</h2>
        <ol class="method-list">{tool.method.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}</ol>
      </section>
      <section>
        <p class="eyebrow">Know the boundary</p>
        <h2>Assumptions and limitations</h2>
        <p>A useful shop result makes its assumptions visible. Check these conditions against your stock, hardware and machine setup.</p>
        <ul class="check-list">{tool.limits.map((limit) => <li>{limit}</li>)}</ul>
      </section>
      <section>
        <p class="eyebrow">Common questions</p>
        <h2>About this calculation</h2>
        <div class="faq-list">{tool.faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">＋</span></summary><p>{faq.answer}</p></details>)}</div>
      </section>
      <section>
        <p class="eyebrow">Reference foundation</p>
        <h2>Sources used for definitions and limits</h2>
        <p>These primary references establish units, material terminology, safety boundaries or manufacturer-specific constraints. The calculator formula and implementation are original to Dama Workshop unless otherwise noted.</p>
        <ol class="source-list">{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.title}</strong><span>{source.note}</span></a></li>)}</ol>
      </section>
    </div>
  </article>

  <section class="section section--paper">
    <div class="shell"><div class="section-head"><div><p class="eyebrow">Continue the job</p><h2>Related calculators</h2></div><a class="text-link" href="/tools/">View all tools →</a></div><div class="tool-grid">{related.map((item) => <ToolCard tool={item} compact />)}</div></div>
  </section>
</BaseLayout>
