---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Free Batch Product Photo Resizer & Image Prep"
  activeNav="/"
  description="Resize product photos, add margins, check thumbnail crops, rename files and download a ZIP. Free image preparation in your browser, without image uploads."
>
  <section class="workspace-heading shell">
    <div>
      <p class="eyebrow">THE PRODUCT PHOTO WORKSPACE</p><h1>
        One batch. Ready for your shop.
      </h1><p>
        Resize, check the framing, and export consistently named product photos.
      </p>
    </div><span class="local-badge">● Images stay on your device</span>
  </section>
  <div class="shell workspace" id="workspace">
    <aside class="settings-panel">
      <form id="settings-form">
        <div class="panel-heading">
          <h2><span class="step">01</span> Set your output</h2><button
            type="button"
            class="text-button"
            id="reset-settings">Reset</button
          >
        </div>
        <label for="preset">Starting size</label><select id="preset"
          ><option value="square">Square · 2000 × 2000</option><option
            value="landscape">Landscape · 2400 × 1800</option
          ><option value="portrait">Portrait · 1800 × 2400</option><option
            value="custom">Custom dimensions</option
          ></select
        ><p class="field-note">
          Workflow presets, not marketplace requirements.
        </p>
        <div class="field-pair">
          <div>
            <label for="width">Width (px)</label><input
              id="width"
              type="number"
              min="64"
              max="4096"
              step="1"
              value="2000"
              required
            />
          </div><div>
            <label for="height">Height (px)</label><input
              id="height"
              type="number"
              min="64"
              max="4096"
              step="1"
              value="2000"
              required
            />
          </div>
        </div>
        <label for="fit">How the photo fits</label><select id="fit"
          ><option value="contain">Fit whole photo + padding</option><option
            value="cover">Fill frame + crop edges</option
          ></select
        >
        <div id="padding-control">
          <label for="padding"
            >Inner margin <output id="padding-value">5%</output></label
          ><input id="padding" type="range" min="0" max="20" value="5" />
        </div>
        <div class="field-pair">
          <div>
            <label for="background">Background</label><input
              id="background"
              type="color"
              value="#ffffff"
            />
          </div><div>
            <label for="anchor">Crop position</label><select id="anchor"
              ><option value="center">Center</option><option value="top"
                >Top</option
              ><option value="bottom">Bottom</option><option value="left"
                >Left</option
              ><option value="right">Right</option></select
            >
          </div>
        </div>
        <label class="check-label"
          ><input type="checkbox" id="upscale" /> Allow enlarging small photos</label
        ><p class="field-note">
          Off: small photos get extra padding. Enlarging cannot restore missing
          detail.
        </p><div class="section-rule"></div>
        <div class="field-pair">
          <div>
            <label for="format">File format</label><select id="format"
              ><option value="jpeg">JPG</option><option value="webp"
                >WebP</option
              ><option value="png">PNG</option></select
            >
          </div><div>
            <label for="quality"
              >Quality <output id="quality-value">85%</output></label
            ><input id="quality" type="range" min="40" max="100" value="85" />
          </div>
        </div><p class="field-note">
          PNG ignores quality. All outputs use your background color, including
          transparent inputs.
        </p>
        <label for="prefix">Product code / filename prefix</label><input
          id="prefix"
          type="text"
          maxlength="60"
          value="product"
          autocomplete="off"
          spellcheck="false"
        /><label for="start">First sequence number</label><input
          id="start"
          type="number"
          min="1"
          max="999999"
          step="1"
          value="1"
          required
        /><p class="filename-example">
          Example: <code id="filename-example">product-001.jpg</code>
        </p>
        <button type="button" class="button secondary full" id="save-settings"
          >Save these settings</button
        ><button type="button" class="text-button full" id="forget-settings"
          >Forget saved settings</button
        ><p class="field-note" id="saved-status" role="status">
          Optional. Saved in this browser only; never your photos.
        </p>
      </form>
    </aside>
    <section class="batch-panel" aria-labelledby="batch-title">
      <div class="panel-heading">
        <h2 id="batch-title">
          <span class="step">02</span> Add your photos
        </h2><span class="count" id="file-count">0 / 20</span>
      </div>
      <div class="drop-zone" id="drop-zone">
        <div class="upload-symbol" aria-hidden="true">↑</div><h3>
          Drop product photos here
        </h3><p>JPG, PNG or static WebP · up to 20 photos</p><label
          class="button"
          for="file-input">Choose photos</label
        ><input
          class="visually-hidden"
          type="file"
          id="file-input"
          accept="image/jpeg,image/png,image/webp"
          multiple
        /><button class="text-button" type="button" id="demo"
          >Try a sample batch</button
        ><p class="field-note">
          20 MB per file · 24 megapixels · 100 MB total input
        </p>
      </div>
      <noscript
        ><p class="notice">
          JavaScript is needed for local image processing. All photo guides
          remain available without it.
        </p></noscript
      ><p id="status" role="status" aria-live="polite" class="status-line">
        Choose a few photos to begin. Your originals are never changed.
      </p><ul id="file-errors" class="file-errors" aria-live="polite"></ul>
      <p class="field-note">
        <a href="#settings-form" id="settings-summary"
          >2000 × 2000 · JPG · Fit — change settings</a>
      </p>
      <div class="batch-toolbar">
        <p id="batch-summary">No photos selected</p><button
          type="button"
          id="clear"
          class="text-button"
          disabled>Clear batch</button
        >
      </div><div class="file-grid" id="file-grid"></div>
      <div class="export-bar">
        <div>
          <strong id="export-summary">Your next listing starts here.</strong><p>
            Output limited to 12 megapixels per image.
          </p>
        </div><div class="export-actions">
          <button class="button" type="button" id="process" disabled
            >Prepare images</button
          ><button class="button dark" type="button" id="download" disabled
            >Download ZIP</button
          ><button class="text-button" type="button" id="cancel" hidden
            >Cancel</button
          >
        </div>
      </div><progress
        id="progress"
        max="100"
        value="0"
        hidden
        aria-label="Batch progress"></progress>
      <section
        id="preview-panel"
        class="preview-panel"
        hidden
        aria-labelledby="preview-title"
      >
        <div class="panel-heading">
          <h2 id="preview-title">
            <span class="step">03</span> Check the framing
          </h2><button class="text-button" id="close-preview" type="button"
            >Close preview</button
          >
        </div><p id="preview-name"></p><div class="crop-grid">
          <figure>
            <canvas
              role="img"
              aria-label="Prepared image crop preview"
              id="crop-square"
              width="300"
              height="300"></canvas><figcaption>Square · 1:1</figcaption>
          </figure><figure>
            <canvas
              role="img"
              aria-label="Prepared image crop preview"
              id="crop-landscape"
              width="400"
              height="300"></canvas><figcaption>Landscape · 4:3</figcaption>
          </figure><figure>
            <canvas
              role="img"
              aria-label="Prepared image crop preview"
              id="crop-portrait"
              width="300"
              height="400"></canvas><figcaption>Portrait · 3:4</figcaption>
          </figure>
        </div><p class="field-note">
          Illustrative center crops of the exported image, not exact platform
          previews. Check your listing before publishing.
        </p>
      </section>
    </section>
  </div>
  <section class="shell workflow-notes">
    <div>
      <span class="note-number">01 / CONSISTENCY</span><h2>
        Keep the whole product in frame.
      </h2><p>
        Use “Fit whole photo” for a mixed batch. Matching canvas sizes and
        margins add consistency without stretching your products.
      </p>
    </div><div>
      <span class="note-number">02 / CONTROL</span><h2>
        Check before you publish.
      </h2><p>
        A square file can still be cropped in search results. Compare three
        thumbnail shapes and look for clipped handles, labels or edges.
      </p>
    </div><div>
      <span class="note-number">03 / REPEAT</span><h2>
        Make next week easier.
      </h2><p>
        Save a size, background and naming pattern. Reuse the recipe for your
        next batch. No account or marketplace connection required.
      </p>
    </div>
  </section>
  <section class="shell reading-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A BETTER EXPORT, NOT JUST A SMALLER FILE</p><h2>
          Practical photo preparation guides
        </h2>
      </div><a href="/guides/">All guides →</a>
    </div><div class="guide-grid">
      <a class="guide-card" href="/guides/fit-vs-fill/"
        ><span>FRAMING</span><h3>Fit or fill? Keep the important edges.</h3><p>
          Where padding helps and where cropping removes detail.
        </p></a
      ><a class="guide-card" href="/guides/file-size-and-quality/"
        ><span>FILE QUALITY</span><h3>Smaller files without guessing.</h3><p>
          Compare dimensions, compression and sharpness.
        </p></a
      ><a class="guide-card" href="/guides/product-photo-workflow/"
        ><span>BATCH WORKFLOW</span><h3>
          From originals to an organized batch.
        </h3><p>A repeatable review routine for each product you publish.</p></a
      >
    </div>
  </section>
  <section class="shell faq-section">
    <h2>Before you start</h2><details>
      <summary>Are my photos uploaded?</summary><p>
        No. Selected files and downloads are processed in your browser. The
        website still makes ordinary page requests to its host. <a
          href="/privacy/">Read the privacy explanation.</a
        >
      </p>
    </details><details>
      <summary>Does it remove backgrounds or fix blurry photos?</summary><p>
        No. It changes canvas size, framing, padding, format and filenames. It
        does not isolate products, retouch images or create missing detail.
      </p>
    </details><details>
      <summary>Is this an official Etsy or Shopify tool?</summary><p>
        No. Dama Image Prep is independent. Presets are starting points, not a
        guarantee of marketplace acceptance. Check the current platform
        requirements and your final listing preview.
      </p>
    </details><details>
      <summary>Why is a file rejected or a batch slow?</summary><p>
        We limit file sizes and dimensions to keep local processing manageable.
        HEIC, SVG, GIF and animations are unsupported. Try a smaller batch on
        older phones. <a href="/standards/">See limits and methods.</a>
      </p>
    </details>
  </section>
</BaseLayout>
<script>
  import "../scripts/workspace";
</script>
