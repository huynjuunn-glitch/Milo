---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { HUBS } from '../data/site';
import { getPublicGuides } from '../lib/guides';

const guides = await getPublicGuides();
const featured = guides.filter((guide) => guide.data.featured).slice(0, 4);
const hubOrder = ['seoul-palaces', 'gyeongju', 'korean-temples', 'visit'] as const;
---

<BaseLayout
  title="Dama Korea"
  description="Independent English-language field guides to Korean palaces, temples, historic cities and practical heritage visits."
>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Korean heritage field guides</p>
        <h1>See the place.<br /><em>Read the layers.</em></h1>
        <p>Practical, source-led guides for understanding Korean palaces, temples and historic landscapes while planning a visit that works on the ground.</p>
        <div class="actions"><a class="button" href="/start-here/">Choose a starting point</a><a class="text-link" href="/about/">How the guides are made <span>→</span></a></div>
      </div>
      <div class="home-hero__visual" aria-hidden="true">
        <div class="roof-lines"><span></span><span></span><span></span></div>
        <div class="field-stamp"><strong>담</strong><small>FIELD GUIDE<br />NO. 01</small></div>
        <p>Architecture · ritual · landscape · route</p>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell">
      <div class="section-head"><div><p class="eyebrow">Explore by field</p><h2>Four ways into Korean heritage</h2></div><p>Start with a place, a living tradition or the practical decisions that connect the day.</p></div>
      <div class="hub-card-grid">
        {hubOrder.map((key, index) => {
          const hub = HUBS[key];
          return <a class="hub-card" href={hub.href}><span>{String(index + 1).padStart(2, '0')} · {hub.eyebrow}</span><h3>{hub.label}</h3><p>{hub.description}</p><strong>Open the collection →</strong></a>;
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell editorial-principles">
      <div><p class="eyebrow">Editorial method</p><h2>A field guide should show its work.</h2><p>We separate durable historical context from details that need a fresh official check. Every published guide identifies what each source verifies and records material updates.</p><a class="button button--secondary" href="/about/">Read the methodology</a></div>
      <ol>
        <li><span>01</span><div><strong>Begin with the responsible source</strong><p>Heritage authorities, museums and transport operators anchor claims that can change.</p></div></li>
        <li><span>02</span><div><strong>Add original decision value</strong><p>Routes, comparisons and visual reading cues help readers act on the information.</p></div></li>
        <li><span>03</span><div><strong>Keep uncertainty visible</strong><p>Access restrictions, weather and site-specific conduct are never hidden behind certainty.</p></div></li>
      </ol>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section section--paper">
      <div class="shell">
        <div class="section-head"><div><p class="eyebrow">Editorial selection</p><h2>Begin with these field guides</h2></div><a class="text-link" href="/culture/">Browse all guides →</a></div>
        <div class="guide-grid">{featured.map((guide, index) => <GuideCard guide={guide} featured={index === 0} />)}</div>
      </div>
    </section>
  )}

  <section class="section source-callout">
    <div class="shell source-callout__inner"><div><p class="eyebrow">Before the gate</p><h2>Check the plan, then stay curious.</h2></div><p>Use the free planning worksheet to save the official notice, Korean place name, practical entrance and one fallback before leaving reliable Wi-Fi.</p><a class="button button--light" href="/tools/">Open the visit worksheet</a></div>
  </section>
</BaseLayout>
