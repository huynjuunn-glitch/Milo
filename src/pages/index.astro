---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { guides } from "../data/guides";
import { experiments, marketplaceReferences } from "../data/content";
import { SITE } from "../data/site";
---

<BaseLayout
  title="Practical Etsy Seller Workflows"
  description="Source-led Etsy seller guides, marketplace references and reproducible image experiments, with privacy-first browser tools for small shops."
  image="/images/image-workspace.png"
  imageAlt="Seller Operations Lab content hub with guides, source references and browser tools."
  activeNav="/"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: "en-US",
    publisher: { "@id": `${SITE.url}/#organization` },
  }}
>
  <section class="hub-hero shell">
    <div class="hub-hero-copy">
      <p class="eyebrow">SELLER OPERATIONS LAB</p>
      <h1>Make fewer listing decisions by guesswork.</h1>
      <p class="hero-lede">
        Practical Etsy workflows, source-checked marketplace references and
        small browser tools for preparing product files before you publish.
      </p>
      <div class="hero-actions">
        <a class="button" href="/start-here/">Start with a workflow</a>
        <a class="button secondary" href="/tools/">Browse tools</a>
      </div>
      <p class="trust-line">Independent · English only · Files stay on your device</p>
    </div>
    <aside class="hub-hero-note">
      <p class="eyebrow">OUR PROMISE</p>
      <h2>Evidence before certainty.</h2>
      <p>
        We separate official platform guidance from independent tests, show
        what was checked and state the limits of every recommendation.
      </p>
      <a href="/methodology/">How the research is checked →</a>
    </aside>
  </section>

  <section class="shell hub-section" aria-labelledby="start-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">START HERE</p>
        <h2 id="start-heading">Three questions before a listing goes live</h2>
      </div>
      <a href="/guides/">View all guides →</a>
    </div>
    <div class="content-grid three-up">
      {guides.slice(0, 3).map((guide) => (
        <ContentCard
          eyebrow={guide.category}
          title={guide.title}
          description={guide.description}
          href={`/guides/${guide.slug}/`}
          meta={`Checked ${guide.updated}`}
        />
      ))}
    </div>
  </section>

  <section class="shell hub-section tinted" aria-labelledby="reference-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">MARKETPLACE REFERENCE</p>
        <h2 id="reference-heading">Platform facts, clearly separated from our advice</h2>
      </div>
      <a href="/marketplace/">All references →</a>
    </div>
    <div class="content-grid two-up">
      {marketplaceReferences.filter((item) => item.slug === "etsy").map((item) => (
        <ContentCard
          eyebrow={item.category}
          title={item.title}
          description={item.description}
          href={`/marketplace/${item.slug}/`}
          meta={`Official sources checked ${item.lastVerified}`}
        />
      ))}
      <article class="content-card secondary-card">
        <p class="eyebrow">SECONDARY REFERENCE</p>
        <h3><a href="/marketplace/shopify/">Shopify product image reference</a></h3>
        <p>Kept as a secondary comparison for sellers who also publish outside Etsy. Theme behavior is discussed separately from Etsy guidance.</p>
        <a class="text-link" href="/marketplace/shopify/">Read the Shopify reference →</a>
      </article>
    </div>
  </section>

  <section class="shell hub-section" aria-labelledby="experiment-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE LAB</p>
        <h2 id="experiment-heading">Small tests that answer practical questions</h2>
      </div>
      <a href="/experiments/">See all experiments →</a>
    </div>
    <div class="content-grid three-up">
      {experiments.map((item) => (
        <ContentCard
          eyebrow={item.category}
          title={item.title}
          description={item.description}
          href={`/experiments/${item.slug}/`}
          meta={`Rechecked ${item.lastVerified}`}
        />
      ))}
    </div>
  </section>

  <section class="shell tool-callout" aria-labelledby="tool-heading">
    <div>
      <p class="eyebrow">TOOLS ARE THE SHORTCUT, NOT THE WHOLE SITE</p>
      <h2 id="tool-heading">Prepare files locally before you publish.</h2>
      <p>
        Resize, pad, preview crops, rename and export a batch without sending
        images to a server. Use the guides to understand the decision before
        opening the tool.
      </p>
    </div>
    <a class="button dark" href="/tools/image-prep/">Open Image Prep →</a>
  </section>

  <section class="shell hub-section final-note" aria-labelledby="method-heading">
    <div>
      <p class="eyebrow">TRANSPARENT BY DESIGN</p>
      <h2 id="method-heading">No invented credentials. No marketplace affiliation.</h2>
      <p>
        The site is maintained as an independent editorial and software
        project. Examples are reproducible calculations or browser tests, not
        claims of personal sales history. Read the methodology, limitations and
        source list before relying on a result.
      </p>
    </div>
    <div class="final-links">
      <a href="/methodology/">Read the methodology</a>
      <a href="/about/">About the project</a>
      <a href="/contact/">Report a correction</a>
    </div>
  </section>
</BaseLayout>
