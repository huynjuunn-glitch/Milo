---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { guides } from "../data/guides";
import { experiments, marketplaceReferences } from "../data/content";
import { SITE } from "../data/site";
---

<BaseLayout
  title="Product Image Workflows for Online Sellers"
  description="Prepare product photos with practical guides, source-checked Etsy and Shopify references, reproducible browser tests, and local tools."
  image="/images/image-workspace.png"
  imageAlt="Seller Operations Lab content hub with guides, source references and browser tools."
  activeNav="/"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: "en-US",
    publisher: { "@id": `${SITE.url}/#organization` },
  }}
>
  <section class="hub-hero shell">
    <div class="hub-hero-copy">
      <p class="eyebrow">SELLER OPERATIONS LAB</p>
        <h1>Prepare product photos with fewer unknowns.</h1>
      <p class="hero-lede">
        Practical image workflows for independent online sellers: frame the
        product, compare real export sizes, and check platform-specific facts
        before publishing.
      </p>
      <div class="hero-actions">
        <a class="button" href="/start-here/">Start with a workflow</a>
        <a class="button secondary" href="/tools/">Browse tools</a>
      </div>
      <p class="trust-line">Independent · English · Files stay on your device</p>
    </div>
    <aside class="hub-hero-note">
      <p class="eyebrow">OUR PROMISE</p>
      <h2>Evidence before certainty.</h2>
      <p>
        We separate platform requirements from workflow advice, show how
        browser tests were run, and state what each result cannot prove.
      </p>
      <a href="/methodology/">How the research is checked →</a>
    </aside>
  </section>

  <section class="shell hub-section" aria-labelledby="start-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">START HERE</p>
        <h2 id="start-heading">Three image decisions before you publish</h2>
      </div>
      <a href="/guides/">View all guides →</a>
    </div>
    <div class="content-grid three-up">
      {guides.filter((guide) => guide.slug !== "consistent-product-grid").slice(0, 3).map((guide) => (
        <ContentCard
          eyebrow={guide.category}
          title={guide.title}
          description={guide.description}
          href={`/guides/${guide.slug}/`}
          meta={`Checked ${guide.updated}`}
        />
      ))}
    </div>
  </section>

  <section class="shell hub-section tinted" aria-labelledby="reference-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">MARKETPLACE REFERENCE</p>
        <h2 id="reference-heading">Platform facts, separated from workflow advice</h2>
      </div>
      <a href="/marketplace/">All references →</a>
    </div>
    <div class="content-grid two-up">
      {marketplaceReferences.map((item) => (
        <ContentCard
          eyebrow={item.category}
          title={item.title}
          description={item.description}
          href={`/marketplace/${item.slug}/`}
          meta={`Official sources checked ${item.lastVerified}`}
        />
      ))}
    </div>
  </section>

  <section class="shell hub-section" aria-labelledby="experiment-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE LAB</p>
        <h2 id="experiment-heading">Reproducible tests with visible limits</h2>
      </div>
      <a href="/experiments/">See all experiments →</a>
    </div>
    <div class="content-grid three-up">
      {experiments.map((item) => (
        <ContentCard
          eyebrow={item.category}
          title={item.title}
          description={item.description}
          href={`/experiments/${item.slug}/`}
          meta={`Rechecked ${item.lastVerified}`}
        />
      ))}
    </div>
  </section>

  <section class="shell tool-callout" aria-labelledby="tool-heading">
    <div>
      <p class="eyebrow">TOOLS WITH A CLEAR JOB</p>
      <h2 id="tool-heading">Prepare and compare files locally.</h2>
      <p>
        Resize, preview crops, compare formats, rename and export without
        sending images to a server. The guides explain what to check and why.
      </p>
    </div>
    <div class="hero-actions">
      <a class="button dark" href="/tools/image-prep/">Open Image Prep →</a>
      <a class="button secondary" href="/tools/format-compare/">Compare formats →</a>
    </div>
  </section>

  <section class="shell hub-section final-note" aria-labelledby="method-heading">
    <div>
      <p class="eyebrow">TRANSPARENT BY DESIGN</p>
        <h2 id="method-heading">Clear sources. No claimed seller results.</h2>
      <p>
        Seller Operations Lab is an independent editorial and software
        project, not an Etsy or Shopify partner. Platform facts link to their
        sources; tests disclose their inputs and limits. We do not claim
        personal sales results or firsthand seller experience.
      </p>
    </div>
    <div class="final-links">
      <a href="/methodology/">Read the methodology</a>
      <a href="/about/">About the project</a>
      <a href="/contact/">Report a correction</a>
    </div>
  </section>
</BaseLayout>
