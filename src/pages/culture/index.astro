---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { HUBS } from '../../data/site';
import { getPublicGuides } from '../../lib/guides';

const guides = await getPublicGuides();
const hubOrder = ['seoul-palaces', 'gyeongju', 'korean-temples', 'visit'] as const;
---

<BaseLayout title="Korean Heritage Field Guides" description="Browse every published Dama Korea field guide by place, heritage tradition and practical visit need.">
  <section class="page-hero"><div class="shell visual-shell"><div><p class="eyebrow">Complete field index</p><h1>Korean heritage, organized for a real visit.</h1><p class="page-hero__lede">Explore every collection or move directly into a published guide. Drafts never appear in this index.</p></div></div></section>
  <section class="section section--paper"><div class="shell hub-index">
    {hubOrder.map((key) => { const hub = HUBS[key]; const count = guides.filter((guide) => guide.data.section === key).length; return <a href={hub.href}><p>{hub.eyebrow}</p><h2>{hub.label}</h2><span>{hub.description}</span><strong>{count} published {count === 1 ? 'guide' : 'guides'} →</strong></a>; })}
  </div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Publication index</p><h2>Every published guide</h2></div><p>Publication requires source roles, visual metadata, dates, change history, schema validation and route checks.</p></div>
    {guides.length > 0 ? <div class="guide-grid">{guides.map((guide) => <GuideCard guide={guide} />)}</div> : <div class="editorial-state"><strong>No drafts are exposed as finished guides.</strong><p>The publication index will populate only after the publication checks succeed.</p></div>}
  </div></section>
</BaseLayout>
